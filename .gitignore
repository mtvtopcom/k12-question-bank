# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 数据与数据库（体积大、可再生的中间产物）
data/*.db
data/*.db-wal
data/*.db-shm
data/topics.jsonl

# 题目导出产物（可再生的运行结果，不随仓库分发）
output/*
!output/.gitkeep

#  macOS 系统文件
.DS_Store
.AppleDouble
.LSOverride

# 环境变量与密钥（切勿提交）
.env
*.key
secrets.*

# 编辑器
.vscode/
.idea/
*.swp

# 桌面管理台的运行时数据与打包产物（.app 随 GitHub Release 分发）
desktop/backups/
desktop/changelog.jsonl
desktop/build/
desktop/*.app/
